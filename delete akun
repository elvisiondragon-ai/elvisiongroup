  -- Detailed view of last 5 signups
  SELECT
      au.email,
      au.created_at as signup_time,
      au.email_confirmed_at as confirmed_time,
      au.last_sign_in_at as last_login,
      p.display_name,
      p.user_email as profile_email,
      p.level,
      p.experience_points as xp
  FROM auth.users au
  LEFT JOIN public.profiles p ON au.id = p.user_id
  ORDER BY au.created_at DESC
  LIMIT 5;

  -- Delete last 5 users and their profiles
  WITH last_15_users AS (
    SELECT id
    FROM auth.users
    ORDER BY created_at DESC
    LIMIT 5
  )
  DELETE FROM auth.users
  WHERE id IN (SELECT id FROM last_15_users);